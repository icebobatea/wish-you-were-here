{
  "$schema": "https://vega.github.io/schema/vega/v5.json",
  "description": "Zoomable flow map: postcards sent between countries, drawn as arrows from sender to recipient.",
  "autosize": "none",
  "padding": 0,
  "signals": [
    {
      "name": "width",
      "init": "isFinite(containerSize()[0]) && containerSize()[0] > 0 ? containerSize()[0] : 760",
      "on": [
        {
          "events": "window:resize",
          "update": "isFinite(containerSize()[0]) && containerSize()[0] > 0 ? containerSize()[0] : 760"
        }
      ]
    },
    {
      "name": "height",
      "update": "max(300, min(470, round(width * 0.603)))"
    },
    {
      "name": "zoom",
      "value": 1,
      "bind": {
        "input": "range",
        "min": 1,
        "max": 10,
        "step": 0.1,
        "name": "Zoom "
      },
      "on": [
        {
          "events": {
            "type": "wheel",
            "consume": true,
            "filter": "event.ctrlKey"
          },
          "update": "clamp(zoom * pow(1.003, -event.deltaY), 1, 10)"
        },
        {
          "events": "dblclick",
          "update": "1"
        }
      ]
    },
    {
      "name": "angles",
      "value": [
        0,
        0
      ],
      "on": [
        {
          "events": "pointerdown",
          "update": "[rotateX, centerY]"
        }
      ]
    },
    {
      "name": "cloned",
      "value": null,
      "on": [
        {
          "events": "pointerdown",
          "update": "copy('projection')"
        }
      ]
    },
    {
      "name": "start",
      "value": null,
      "on": [
        {
          "events": "pointerdown",
          "update": "invert(cloned, xy())"
        }
      ]
    },
    {
      "name": "drag",
      "value": null,
      "on": [
        {
          "events": "[pointerdown, window:pointerup] > window:pointermove",
          "update": "invert(cloned, xy())"
        }
      ]
    },
    {
      "name": "delta",
      "value": null,
      "on": [
        {
          "events": {
            "signal": "drag"
          },
          "update": "[drag[0] - start[0], start[1] - drag[1]]"
        }
      ]
    },
    {
      "name": "rotateX",
      "value": -60,
      "on": [
        {
          "events": {
            "signal": "delta"
          },
          "update": "angles[0] + delta[0]"
        },
        {
          "events": "dblclick",
          "update": "-60"
        }
      ]
    },
    {
      "name": "centerY",
      "value": 10,
      "on": [
        {
          "events": {
            "signal": "delta"
          },
          "update": "clamp(angles[1] + delta[1], -70, 70)"
        },
        {
          "events": "dblclick",
          "update": "10"
        }
      ]
    }
  ],
  "projections": [
    {
      "name": "projection",
      "type": "equalEarth",
      "scale": {
        "signal": "width / 5.4 * zoom"
      },
      "rotate": [
        {
          "signal": "rotateX"
        },
        0,
        0
      ],
      "center": [
        0,
        {
          "signal": "centerY"
        }
      ],
      "translate": [
        {
          "signal": "width / 2"
        },
        {
          "signal": "height / 2"
        }
      ]
    }
  ],
  "data": [
    {
      "name": "world",
      "url": "data/ne_110m_admin_0_countries.topojson",
      "format": {
        "type": "topojson",
        "feature": "ne_110m_admin_0_countries"
      }
    },
    {
      "name": "flows",
      "url": "data/flows.csv",
      "format": {
        "type": "csv",
        "parse": "auto"
      },
      "transform": [
        {
          "type": "geopoint",
          "projection": "projection",
          "fields": [
            "lon_from",
            "lat_from"
          ],
          "as": [
            "fx",
            "fy"
          ]
        },
        {
          "type": "geopoint",
          "projection": "projection",
          "fields": [
            "lon_to",
            "lat_to"
          ],
          "as": [
            "tx",
            "ty"
          ]
        },
        {
          "type": "formula",
          "as": "cx",
          "expr": "(datum.fx + datum.tx) / 2 - 0.22 * (datum.ty - datum.fy)"
        },
        {
          "type": "formula",
          "as": "cy",
          "expr": "(datum.fy + datum.ty) / 2 + 0.22 * (datum.tx - datum.fx)"
        },
        {
          "type": "formula",
          "as": "path",
          "expr": "'M' + datum.fx + ',' + datum.fy + 'Q' + datum.cx + ',' + datum.cy + ' ' + datum.tx + ',' + datum.ty"
        },
        {
          "type": "formula",
          "as": "angle",
          "expr": "atan2(datum.ty - datum.cy, datum.tx - datum.cx) * 180 / PI"
        },
        {
          "type": "formula",
          "as": "ax",
          "expr": "datum.tx - 7 * cos((datum.angle) * PI / 180)"
        },
        {
          "type": "formula",
          "as": "ay",
          "expr": "datum.ty - 7 * sin((datum.angle) * PI / 180)"
        }
      ]
    },
    {
      "name": "places",
      "url": "data/flow_places.csv",
      "format": {
        "type": "csv",
        "parse": "auto"
      },
      "transform": [
        {
          "type": "geopoint",
          "projection": "projection",
          "fields": [
            "lon",
            "lat"
          ],
          "as": [
            "x",
            "y"
          ]
        }
      ]
    }
  ],
  "scales": [
    {
      "name": "width_scale",
      "type": "linear",
      "domain": [
        1,
        52
      ],
      "range": [
        1.5,
        11
      ]
    },
    {
      "name": "arrow_size",
      "type": "linear",
      "domain": [
        1,
        52
      ],
      "range": [
        60,
        420
      ]
    }
  ],
  "legends": [
    {
      "strokeWidth": "width_scale",
      "title": "Postcards sent",
      "orient": "bottom-left",
      "symbolType": "stroke",
      "values": [
        1,
        5,
        20,
        50
      ],
      "symbolStrokeColor": "#9b2c2c"
    }
  ],
  "marks": [
    {
      "type": "shape",
      "from": {
        "data": "world"
      },
      "clip": true,
      "encode": {
        "enter": {
          "fill": {
            "value": "#e6dcc6"
          },
          "stroke": {
            "value": "#fbf7ef"
          },
          "strokeWidth": {
            "value": 0.6
          }
        }
      },
      "transform": [
        {
          "type": "geoshape",
          "projection": "projection"
        }
      ]
    },
    {
      "type": "path",
      "name": "arcs",
      "from": {
        "data": "flows"
      },
      "clip": true,
      "encode": {
        "enter": {
          "stroke": {
            "value": "#9b2c2c"
          },
          "strokeCap": {
            "value": "round"
          },
          "strokeWidth": {
            "scale": "width_scale",
            "field": "postcards"
          },
          "tooltip": {
            "signal": "{'From': datum.place_from, 'To': datum.place_to, 'Postcards': datum.postcards}"
          }
        },
        "update": {
          "path": {
            "field": "path"
          },
          "strokeOpacity": {
            "value": 0.7
          }
        },
        "hover": {
          "strokeOpacity": {
            "value": 1
          }
        }
      }
    },
    {
      "type": "symbol",
      "name": "arrowheads",
      "from": {
        "data": "flows"
      },
      "clip": true,
      "encode": {
        "enter": {
          "shape": {
            "value": "triangle-right"
          },
          "fill": {
            "value": "#9b2c2c"
          },
          "size": {
            "scale": "arrow_size",
            "field": "postcards"
          }
        },
        "update": {
          "x": {
            "field": "ax"
          },
          "y": {
            "field": "ay"
          },
          "angle": {
            "field": "angle"
          }
        }
      }
    },
    {
      "type": "symbol",
      "name": "ends",
      "from": {
        "data": "places"
      },
      "clip": true,
      "encode": {
        "enter": {
          "size": {
            "value": 40
          },
          "fill": {
            "value": "#3b3226"
          },
          "tooltip": {
            "signal": "{'Place': datum.place, 'Cards sent': datum.sent, 'Cards received': datum.received}"
          }
        },
        "update": {
          "x": {
            "field": "x"
          },
          "y": {
            "field": "y"
          }
        }
      }
    },
    {
      "type": "text",
      "name": "end_labels_halo",
      "from": {
        "data": "places"
      },
      "clip": true,
      "interactive": false,
      "encode": {
        "enter": {
          "fontSize": {
            "value": 12
          },
          "fontWeight": {
            "value": 600
          },
          "fill": {
            "value": "#f4ecdb"
          },
          "stroke": {
            "value": "#f4ecdb"
          },
          "strokeWidth": {
            "value": 4
          },
          "strokeJoin": {
            "value": "round"
          }
        },
        "update": {
          "x": {
            "signal": "datum.x + 4"
          },
          "y": {
            "field": "y"
          },
          "text": {
            "signal": "datum.place"
          }
        }
      },
      "transform": [
        {
          "type": "label",
          "avoidMarks": [
            "ends"
          ],
          "size": {
            "signal": "[width, height]"
          },
          "anchor": [
            "right",
            "top-right",
            "bottom-right"
          ],
          "offset": [
            3,
            2,
            2
          ]
        }
      ]
    },
    {
      "type": "text",
      "name": "end_labels",
      "from": {
        "data": "end_labels_halo"
      },
      "clip": true,
      "interactive": false,
      "encode": {
        "update": {
          "x": {
            "field": "x"
          },
          "y": {
            "field": "y"
          },
          "text": {
            "field": "text"
          },
          "align": {
            "field": "align"
          },
          "baseline": {
            "field": "baseline"
          },
          "opacity": {
            "field": "opacity"
          },
          "fontSize": {
            "value": 12
          },
          "fontWeight": {
            "value": 600
          },
          "fill": {
            "value": "#3b3226"
          }
        }
      }
    }
  ],
  "config": {
    "background": "transparent",
    "text": {
      "font": "Source Serif 4",
      "fill": "#3b3226"
    },
    "legend": {
      "labelFont": "Source Serif 4",
      "titleFont": "Source Serif 4",
      "labelFontSize": 12,
      "titleFontSize": 12,
      "labelColor": "#3b3226",
      "titleColor": "#3b3226",
      "fillColor": "#f4ecdbe6",
      "padding": 8,
      "cornerRadius": 4,
      "labelLimit": 220
    }
  }
}
