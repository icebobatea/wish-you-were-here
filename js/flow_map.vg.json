{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Flow map: international postcards in the collection, from the sender's country to the recipient's.",
  "autosize": {
    "type": "fit",
    "contains": "padding",
    "resize": true
  },
  "padding": {
    "left": 40,
    "right": 10,
    "top": 10,
    "bottom": 5
  },
  "width": "container",
  "height": 420,
  "projection": {
    "type": "equalEarth",
    "rotate": [
      -60,
      0,
      0
    ]
  },
  "layer": [
    {
      "data": {
        "url": "data/ne_110m_admin_0_countries.topojson",
        "format": {
          "type": "topojson",
          "feature": "ne_110m_admin_0_countries"
        }
      },
      "mark": {
        "type": "geoshape",
        "fill": "#e9e1cf",
        "stroke": "#fbf7ef",
        "strokeWidth": 0.6
      }
    },
    {
      "data": {
        "url": "data/flows.geojson",
        "format": {
          "type": "json",
          "property": "features"
        }
      },
      "mark": {
        "type": "geoshape",
        "filled": false,
        "strokeCap": "round",
        "opacity": 0.75,
        "stroke": "#9b2c2c"
      },
      "encoding": {
        "strokeWidth": {
          "field": "properties.postcards",
          "type": "quantitative",
          "title": "Postcards sent",
          "scale": {
            "range": [
              1.5,
              9
            ]
          },
          "legend": {
            "orient": "bottom-left",
            "values": [
              1,
              3,
              10,
              50
            ],
            "symbolType": "stroke",
            "symbolStrokeColor": "#9b2c2c"
          }
        },
        "tooltip": [
          {
            "field": "properties.place_from",
            "title": "From"
          },
          {
            "field": "properties.place_to",
            "title": "To"
          },
          {
            "field": "properties.postcards",
            "type": "quantitative",
            "title": "Postcards"
          }
        ]
      }
    },
    {
      "data": {
        "url": "data/flows.csv"
      },
      "transform": [
        {
          "filter": "datum.postcards >= 2"
        },
        {
          "fold": [
            "from",
            "to"
          ],
          "as": [
            "end",
            "e"
          ]
        },
        {
          "calculate": "datum.end === 'from' ? datum.lon_from : datum.lon_to",
          "as": "lon"
        },
        {
          "calculate": "datum.end === 'from' ? datum.lat_from : datum.lat_to",
          "as": "lat"
        },
        {
          "calculate": "datum.end === 'from' ? datum.place_from : datum.place_to",
          "as": "place"
        },
        {
          "aggregate": [
            {
              "op": "count",
              "as": "n"
            }
          ],
          "groupby": [
            "place",
            "lon",
            "lat"
          ]
        }
      ],
      "layer": [
        {
          "mark": {
            "type": "circle",
            "size": 50,
            "color": "#3b3226"
          },
          "encoding": {
            "longitude": {
              "field": "lon",
              "type": "quantitative"
            },
            "latitude": {
              "field": "lat",
              "type": "quantitative"
            }
          }
        },
        {
          "transform": [
            {
              "filter": "datum.place !== 'London'"
            }
          ],
          "mark": {
            "type": "text",
            "dy": -10,
            "fontSize": 12,
            "fontWeight": 600,
            "color": "#3b3226"
          },
          "encoding": {
            "longitude": {
              "field": "lon",
              "type": "quantitative"
            },
            "latitude": {
              "field": "lat",
              "type": "quantitative"
            },
            "text": {
              "field": "place"
            }
          }
        },
        {
          "transform": [
            {
              "filter": "datum.place === 'London'"
            }
          ],
          "mark": {
            "type": "text",
            "dy": 14,
            "fontSize": 12,
            "fontWeight": 600,
            "color": "#3b3226"
          },
          "encoding": {
            "longitude": {
              "field": "lon",
              "type": "quantitative"
            },
            "latitude": {
              "field": "lat",
              "type": "quantitative"
            },
            "text": {
              "field": "place"
            }
          }
        }
      ]
    },
    {
      "data": {
        "values": [
          {
            "lon": 55,
            "lat": -48,
            "label": "52 cards from Australia to Scotland,\nmost from the Flinns in Melbourne\nto J. B. Scott in Paisley, 1904–07"
          }
        ]
      },
      "mark": {
        "type": "text",
        "font": "Source Serif 4",
        "fontSize": 12,
        "fontStyle": "italic",
        "fill": "#3b3226",
        "lineBreak": "\n",
        "align": "left"
      },
      "encoding": {
        "longitude": {
          "field": "lon",
          "type": "quantitative"
        },
        "latitude": {
          "field": "lat",
          "type": "quantitative"
        },
        "text": {
          "field": "label"
        }
      }
    }
  ],
  "config": {
    "background": "transparent",
    "view": {
      "stroke": null
    },
    "font": "Source Serif 4",
    "axis": {
      "labelColor": "#3b3226",
      "titleColor": "#3b3226",
      "domainColor": "#b9ad97",
      "tickColor": "#b9ad97",
      "gridColor": "#ece4d3",
      "labelFontSize": 12,
      "titleFontSize": 12,
      "titleFontWeight": 600,
      "labelLimit": 280
    },
    "legend": {
      "labelColor": "#3b3226",
      "titleColor": "#3b3226",
      "labelFontSize": 12,
      "titleFontSize": 12,
      "labelLimit": 240
    },
    "text": {
      "font": "Source Serif 4",
      "color": "#3b3226"
    }
  }
}
