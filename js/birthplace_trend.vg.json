          "field": "label"
        }
      }
    },
    {
      "data": {
        "url": "data/vic_birthplace_trend.csv"
      },
      "encoding": {
        "x": {
          "field": "year",
          "type": "quantitative",
          "title": "Census year",
          "scale": {
            "domain": [
              1901,
              2011
            ],
            "nice": false,
            "zero": false
          },
          "axis": {
            "format": "d",
            "values": [
              1901,
              1921,
              1947,
              1961,
              1981,
              2001,
              2011
            ],
            "grid": false
          }
        },
        "y": {
          "field": "persons",
          "type": "quantitative",
          "title": "Victorians born there",
          "scale": {
            "domain": [
              0,
              260000
            ]
          },
          "axis": {
            "format": "~s",
            "tickCount": 5
          }
        },
        "color": {
          "field": "group",
          "type": "nominal",
          "scale": {
            "domain": [
              "Britain",
              "Ireland",
              "Italy",
              "Greece",
              "India",
              "China"
            ],
            "range": [
              "#1a66a8",
              "#1a66a8",
              "#b07d10",
              "#b07d10",
              "#a23b72",
              "#a23b72"
            ]
          },
          "sort": [
            "Britain",
            "Ireland",
            "Italy",
            "Greece",
            "India",
            "China"
          ],
          "legend": {
            "orient": "top",
            "direction": "horizontal",
            "symbolType": "stroke",
            "symbolStrokeWidth": 2.5,
            "symbolSize": 300,
            "title": "Born in (click to highlight)"
          }
        },
        "strokeDash": {
          "field": "group",
          "type": "nominal",
          "scale": {
            "domain": [
              "Britain",
              "Ireland",
              "Italy",
              "Greece",
              "India",
              "China"
            ],
            "range": [
              [
                1,
                0
              ],
              [
                6,
                4
              ],
              [
                1,
                0
              ],
              [
                6,
                4
              ],
              [
                1,
                0
              ],
              [
                6,
                4
              ]
            ]
          },
          "sort": [
            "Britain",
            "Ireland",
            "Italy",
            "Greece",
            "India",
            "China"
          ],
          "legend": {
            "orient": "top",
            "direction": "horizontal",
            "symbolType": "stroke",
            "symbolStrokeWidth": 2.5,
            "symbolSize": 300,
            "title": "Born in (click to highlight)"
          }
        }
      },
      "layer": [
        {
          "params": [
            {
              "name": "pick",
              "select": {
                "type": "point",
                "fields": [
                  "group"
                ]
              },
              "bind": "legend"
            }
          ],
          "mark": {
            "type": "line",
            "strokeWidth": 2.5
          },
          "encoding": {
            "opacity": {
              "condition": {
                "param": "pick",
                "empty": true,
                "value": 1
              },
              "value": 0.12
            }
          }
        },
        {
          "params": [
            {
              "name": "hover",
              "select": {
                "type": "point",
                "fields": [
                  "year"
                ],
                "on": "pointerover",
                "nearest": true,
                "clear": "pointerout"
              }
            }
          ],
          "mark": {
            "type": "point",
            "filled": true,
            "size": 60
          },
          "encoding": {
            "opacity": {
              "condition": {
                "param": "hover",
                "empty": false,
                "value": 1
              },
              "value": 0
            },
            "strokeDash": null,
            "tooltip": [
              {
                "field": "group",
                "title": "Born in"
              },
              {
                "field": "year",
                "title": "Census"
              },
              {
                "field": "persons",
                "type": "quantitative",
                "format": ",",
                "title": "Victorians"
              }
            ]
          }
        },
        {
          "transform": [
            {
              "filter": "datum.year === 2011"
            }
          ],
          "mark": {
            "type": "text",
            "align": "left",
            "dx": 6,
            "fontSize": 12,
            "fontWeight": 600
          },
          "encoding": {
            "text": {
              "field": "group"
            },
            "strokeDash": null,
            "opacity": {
              "condition": {
                "param": "pick",
                "empty": true,
                "value": 1
              },
              "value": 0.2
            }
          }
        }
      ]
    },
