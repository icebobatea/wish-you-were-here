    },
    {
      "data": {
        "values": [
          {
            "year": 1947,
            "label": "1947: post-war|migration scheme begins",
            "y": 6,
            "align": "right",
            "dx": -4
          },
          {
            "year": 1973,
            "label": "1973: White Australia|policy ends",
            "y": 95,
            "align": "right",
            "dx": -4
          }
        ]
      },
      "transform": [
        {
          "filter": "datum.year === 1973"
        }
      ],
      "mark": {
        "type": "text",
        "font": "Source Serif 4",
        "fontSize": 11,
        "fontStyle": "italic",
        "fill": "#3b3226",
        "align": "right",
        "dx": -4,
        "y": 95,
        "lineBreak": "|",
        "baseline": "top"
      },
      "encoding": {
        "x": {
          "field": "year",
          "type": "quantitative",
