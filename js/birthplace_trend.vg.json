{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Line chart: Victorians born in six countries at each census, 1901-2011, with policy events marked.",
  "autosize": {
    "type": "fit",
    "contains": "padding",
    "resize": true
  },
  "padding": {
    "left": 8,
    "right": 60,
    "top": 10,
    "bottom": 6
  },
  "width": "container",
  "height": 340,
  "layer": [
    {
      "data": {
        "values": [
          {
            "year": 1947,
            "label": "1947: post-war|migration scheme begins",
            "y": 6,
            "align": "right",
            "dx": -4
          },
          {
            "year": 1973,
            "label": "1973: White Australia|policy ends",
            "y": 95,
            "align": "right",
            "dx": -4
          }
        ]
      },
      "mark": {
        "type": "rule",
        "strokeDash": [
          3,
          3
        ],
        "color": "#6e6253"
      },
      "encoding": {
        "x": {
          "field": "year",
          "type": "quantitative",
          "scale": {
            "domain": [
              1901,
              2011
            ],
            "nice": false,
            "zero": false
          }
        }
      }
    },
    {
