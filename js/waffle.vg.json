{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Waffle chart: if the collection were 100 postcards, how many of each theme. Click the legend to highlight.",
  "autosize": {
    "type": "pad"
  },
  "padding": {
    "left": 16,
    "right": 12,
    "top": 10,
    "bottom": 6
  },
  "width": 300,
  "height": 300,
  "data": {
    "url": "data/waffle.csv"
  },
  "params": [
    {
      "name": "pick",
      "bind": "legend",
      "select": {
        "type": "point",
        "fields": [
          "theme"
        ],
        "toggle": "true"
      }
    }
  ],
  "mark": {
    "type": "rect",
    "cornerRadius": 3,
    "stroke": "#fbf7ef",
    "strokeWidth": 3
  },
  "encoding": {
    "x": {
      "field": "col",
      "type": "ordinal",
      "axis": null
    },
    "y": {
      "field": "row",
      "type": "ordinal",
      "axis": null
    },
    "color": {
      "field": "theme",
      "type": "nominal",
      "title": null,
      "scale": {
        "domain": [
          "Exhibition Building",
          "War & service",
          "Migration",
          "Correspondence",
          "Other"
        ],
        "range": [
          "#b07d10",
          "#9b2c2c",
          "#1a66a8",
          "#4a8a32",
          "#a39a8a"
        ]
      },
      "sort": [
        "Exhibition Building",
        "War & service",
        "Migration",
        "Correspondence",
        "Other"
      ],
      "legend": {
        "orient": "right",
        "symbolType": "square",
        "symbolSize": 220,
        "labelFontSize": 15,
        "rowPadding": 10,
        "labelLimit": 300,
        "labelExpr": "{'Exhibition Building': '19  Exhibition Building', 'War & service': '35  War & service', 'Migration': '15  Migration', 'Correspondence': '8  Correspondence', 'Other': '23  Other'}[datum.label]"
      }
    },
    "opacity": {
      "condition": {
        "param": "pick",
        "empty": true,
        "value": 1
      },
      "value": 0.15
    },
    "tooltip": [
      {
        "field": "theme",
        "title": "Theme"
      },
      {
        "field": "share",
        "type": "quantitative",
        "title": "Cards out of 100"
      }
    ]
  },
  "config": {
    "background": "transparent",
    "view": {
      "stroke": null
    },
    "font": "'Source Serif 4', Georgia, serif",
    "axis": {
      "labelColor": "#3b3226",
      "titleColor": "#3b3226",
      "domainColor": "#b9ad97",
      "tickColor": "#b9ad97",
      "gridColor": "#e8decb",
      "labelFontSize": 12,
      "titleFontSize": 12,
      "titleFontWeight": 600,
      "labelLimit": 280
    },
    "legend": {
      "labelColor": "#3b3226",
      "titleColor": "#3b3226",
      "labelFontSize": 12,
      "titleFontSize": 12,
      "labelLimit": 260,
      "symbolType": "circle",
      "columnPadding": 28,
      "rowPadding": 6,
      "labelOffset": 6,
      "padding": 4
    },
    "text": {
      "font": "'Source Serif 4', Georgia, serif",
      "color": "#3b3226"
    }
  }
}
