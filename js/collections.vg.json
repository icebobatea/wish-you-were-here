{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Bar chart: postcards in each museum collection (top 8), with the uncatalogued share highlighted.",
  "autosize": {
    "type": "fit",
    "contains": "padding",
    "resize": true
  },
  "padding": {
    "left": 16,
    "right": 12,
    "top": 10,
    "bottom": 6
  },
  "width": "container",
  "height": 260,
  "data": {
    "url": "data/collections.csv"
  },
  "encoding": {
    "y": {
      "field": "collection",
      "type": "nominal",
      "title": null,
      "sort": [
        "No named collection",
        "Royal Exhibition Building Collection",
        "RSL Collection",
        "Military Memorabilia Collection",
        "Rodda Collection",
        "Museum History Collection",
        "Kodak Heritage Collection",
        "Olive Oliver Collection"
      ],
      "axis": {
        "domain": false,
        "ticks": false,
        "minExtent": 250
      }
    },
    "x": {
      "field": "postcards",
      "type": "quantitative",
      "title": "Postcards",
      "scale": {
        "domain": [
          0,
          400
        ]
      },
      "axis": {
        "grid": true,
        "tickCount": 5
      }
    }
  },
  "layer": [
    {
      "params": [
        {
          "name": "hover",
          "select": {
            "type": "point",
            "on": "pointerover",
            "clear": "pointerout"
          }
        }
      ],
      "mark": {
        "type": "bar",
        "cornerRadiusEnd": 4,
        "height": {
          "band": 0.7
        }
      },
      "encoding": {
        "color": {
          "condition": {
            "test": "datum.collection === 'No named collection'",
            "value": "#cfc5b2"
          },
          "value": "#9b2c2c"
        },
        "opacity": {
          "condition": {
            "param": "hover",
            "empty": true,
            "value": 1
          },
          "value": 0.55
        },
        "tooltip": [
          {
            "field": "collection",
            "title": "Collection"
          },
          {
            "field": "postcards",
            "type": "quantitative",
            "title": "Postcards"
          }
        ]
      }
    },
    {
      "mark": {
        "type": "text",
        "align": "left",
        "dx": 5,
        "fontSize": 11
      },
      "encoding": {
        "text": {
          "field": "postcards",
          "type": "quantitative"
        }
      }
    },
    {
      "data": {
        "values": [
          {
            "collection": "No named collection",
            "postcards": 380,
            "label": "40% of cards: who owned them is unknown"
          }
        ]
      },
      "mark": {
        "type": "text",
        "font": "Source Serif 4",
        "fontSize": 12,
        "fontStyle": "italic",
        "fill": "#3b3226",
        "align": "right",
        "dx": -8
      },
      "encoding": {
        "text": {
          "field": "label"
        }
      }
    },
    {
      "data": {
        "values": [
          {
            "collection": "RSL Collection",
            "postcards": 184,
            "label": "the RSL gave 184 of the 306 WWI-era cards"
          }
        ]
      },
      "mark": {
        "type": "text",
        "font": "Source Serif 4",
        "fontSize": 12,
        "fontStyle": "italic",
        "fill": "#3b3226",
        "align": "left",
        "dx": 36
      },
      "encoding": {
        "text": {
          "field": "label"
        }
      }
    }
  ],
  "config": {
    "background": "transparent",
    "view": {
      "stroke": null
    },
    "font": "Source Serif 4",
    "axis": {
      "labelColor": "#3b3226",
      "titleColor": "#3b3226",
      "domainColor": "#b9ad97",
      "tickColor": "#b9ad97",
      "gridColor": "#e8decb",
      "labelFontSize": 12,
      "titleFontSize": 12,
      "titleFontWeight": 600,
      "labelLimit": 280
    },
    "legend": {
      "labelColor": "#3b3226",
      "titleColor": "#3b3226",
      "labelFontSize": 12,
      "titleFontSize": 12,
      "labelLimit": 260,
      "symbolType": "circle"
    },
    "text": {
      "font": "Source Serif 4",
      "color": "#3b3226"
    }
  }
}
