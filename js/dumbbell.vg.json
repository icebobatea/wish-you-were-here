{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Dumbbell chart: share of each theme among cards from before 1920 versus 1920 onwards, with the change in points.",
  "autosize": {
    "type": "fit",
    "contains": "padding",
    "resize": true
  },
  "padding": {
    "left": 16,
    "right": 12,
    "top": 10,
    "bottom": 6
  },
  "width": "container",
  "height": 240,
  "data": {
    "url": "data/theme_shift.csv"
  },
  "encoding": {
    "y": {
      "field": "theme",
      "type": "nominal",
      "title": null,
      "sort": [
        "Exhibition Building",
        "War & service",
        "Migration",
        "Everyday correspondence",
        "Other"
      ],
      "axis": {
        "domain": false,
        "ticks": false,
        "labelPadding": 8,
        "minExtent": 175
      }
    }
  },
  "layer": [
    {
      "mark": {
        "type": "rule",
        "color": "#b9ad97",
        "strokeWidth": 3
      },
      "encoding": {
        "x": {
          "field": "share",
          "type": "quantitative",
          "aggregate": "min"
        },
        "x2": {
          "field": "share",
          "aggregate": "max"
        }
      }
    },
    {
      "params": [
        {
          "name": "era_pick",
          "select": {
            "type": "point",
            "fields": [
              "era"
            ]
          },
          "bind": "legend"
        }
      ],
      "mark": {
        "type": "circle",
        "size": 170,
        "opacity": 1,
        "stroke": "#fbf7ef",
        "strokeWidth": 2
      },
      "encoding": {
        "x": {
          "field": "share",
          "type": "quantitative",
          "title": "Share of dated postcards (%)",
          "scale": {
            "domain": [
              0,
              62
            ]
          },
          "axis": {
            "values": [
              0,
              10,
              20,
              30,
              40,
              50
            ]
          }
        },
        "color": {
          "field": "era",
          "type": "nominal",
          "title": null,
          "scale": {
            "domain": [
              "Before 1920",
              "1920 onwards"
            ],
            "range": [
              "#9b2c2c",
              "#1a66a8"
            ]
          },
          "legend": {
            "orient": "top",
            "direction": "horizontal"
          }
        },
        "opacity": {
          "condition": {
            "param": "era_pick",
            "empty": true,
            "value": 1
          },
          "value": 0.2
        },
        "tooltip": [
          {
            "field": "theme",
            "title": "Theme"
          },
          {
            "field": "era",
            "title": "Period"
          },
          {
            "field": "share",
            "type": "quantitative",
            "title": "Share (%)"
          }
        ]
      }
    },
    {
      "mark": {
        "type": "text",
        "dy": -14,
        "fontSize": 11,
        "color": "#6e6253"
      },
      "encoding": {
        "x": {
          "field": "share",
          "type": "quantitative"
        },
        "text": {
          "field": "share",
          "type": "quantitative",
          "format": ".0f"
        }
      }
    },
    {
      "transform": [
        {
          "pivot": "era",
          "value": "share",
          "groupby": [
            "theme"
          ]
        },
        {
          "calculate": "datum['1920 onwards'] - datum['Before 1920']",
          "as": "change"
        },
        {
          "calculate": "(datum.change > 0 ? '▲ +' : '▼ ') + format(datum.change, '.0f') + ' pts'",
          "as": "change_label"
        }
      ],
      "mark": {
        "type": "text",
        "align": "left",
        "fontSize": 12,
        "fontWeight": 700,
        "x": {
          "expr": "width - 62"
        }
      },
      "encoding": {
        "text": {
          "field": "change_label"
        },
        "color": {
          "condition": {
            "test": "datum.change > 0",
            "value": "#1a66a8"
          },
          "value": "#9b2c2c"
        }
      }
    }
  ],
  "config": {
    "background": "transparent",
    "view": {
      "stroke": null
    },
    "font": "Source Serif 4",
    "axis": {
      "labelColor": "#3b3226",
      "titleColor": "#3b3226",
      "domainColor": "#b9ad97",
      "tickColor": "#b9ad97",
      "gridColor": "#e8decb",
      "labelFontSize": 12,
      "titleFontSize": 12,
      "titleFontWeight": 600,
      "labelLimit": 280
    },
    "legend": {
      "labelColor": "#3b3226",
      "titleColor": "#3b3226",
      "labelFontSize": 12,
      "titleFontSize": 12,
      "labelLimit": 260,
      "symbolType": "circle"
    },
    "text": {
      "font": "Source Serif 4",
      "color": "#3b3226"
    }
  }
}
